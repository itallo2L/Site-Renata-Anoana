# Variáveis de ambiente do backend (configurar na Vercel, não commitar valores reais)

# Hash bcrypt da senha de acesso ao painel.
# Gerar com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_AQUI', 10))"
ADMIN_PASSWORD_HASH=

# String aleatória longa usada para assinar o cookie de sessão.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Personal Access Token do GitHub (fine-grained) com permissão de leitura/escrita
# em "Contents" apenas neste repositório.
GITHUB_TOKEN=

GITHUB_OWNER=itallo2L
GITHUB_REPO=Site-Renata-Anoana
GITHUB_BRANCH=main

# Origens (sem barra no final) autorizadas a chamar a API via CORS.
# O site continua no GitHub Pages; só a API fica na Vercel (api.renataanoana.com.br).
ALLOWED_ORIGINS=https://renataanoana.com.br,https://www.renataanoana.com.br

# RavenDB Cloud (cloud.ravendb.net) — guarda os dados dos produtos (as fotos
# continuam indo pro GitHub). URLs do cluster, separadas por vírgula se houver mais de um nó.
RAVENDB_URLS=https://a.seu-banco.ravendb.cloud
RAVENDB_DATABASE=renata-anoana

# Certificado cliente (.pfx) que a RavenDB Cloud gera, em base64:
# node -e "console.log(require('fs').readFileSync('caminho/do/certificado.pfx').toString('base64'))"
RAVENDB_CERT_BASE64=
# Senha do certificado, se você definiu uma ao gerá-lo (geralmente fica em branco)
RAVENDB_CERT_PASSWORD=
